{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:${partition}:s3:::${bucket}"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:${partition}:s3:::${bucket}/${state_key}"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:${partition}:s3:::${bucket}/${state_key}.tflock"
    },
    {
      "Effect": "Allow",
      "Action": ["lambda:*"],
      "Resource": [
        "arn:${partition}:lambda:${region}:${account}:function:tagged-api",
        "arn:${partition}:lambda:${region}:${account}:function:tagged-worker"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:${partition}:iam::${account}:role/tagged-api-*",
        "arn:${partition}:iam::${account}:role/tagged-worker-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:${partition}:iam::${account}:role/tagged-api-*",
        "arn:${partition}:iam::${account}:role/tagged-worker-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["cognito-idp:*"],
      "Resource": "arn:${partition}:cognito-idp:${region}:${account}:userpool/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:ListUserPools",
        "cognito-idp:DescribeUserPoolDomain",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE",
        "apigateway:TagResource",
        "apigateway:UntagResource"
      ],
      "Resource": [
        "arn:${partition}:apigateway:${region}::/apis",
        "arn:${partition}:apigateway:${region}::/apis/*",
        "arn:${partition}:apigateway:${region}::/tags/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/tagged-api",
        "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/tagged-api:*",
        "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/tagged-worker",
        "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/tagged-worker:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucket*",
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": "arn:${partition}:s3:::tagged-photos-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": "arn:${partition}:dynamodb:${region}:${account}:table/tagged-photos"
    }
  ]
}
